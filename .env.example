# Database Configuration (Neon PostgreSQL)
# Get this from your Neon project settings
DATABASE_URL=postgresql://user:password@host/database

# Authentication Secrets
# Generate these with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_here_generate_with_openssl_rand_base64_32
NEON_AUTH_COOKIE_SECRET=your_secret_here_generate_with_openssl_rand_base64_32

# Ethereum Configuration
# Reliable Sepolia RPC (avoid deprecated rpc.sepolia.dev)
# Get a dedicated RPC from Infura (https://infura.io) or Alchemy (https://alchemy.com)
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CHAIN_ID=11155111

# Smart Contract Address (required for payments)
# Deploy with: pnpm deploy:contract
# See VERCEL_DEPLOY.md
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Deployer wallet private key — LOCAL ONLY, never commit or add to Vercel
# Used once to deploy the contract to Sepolia via: pnpm deploy:contract
# DEPLOYER_PRIVATE_KEY=your_private_key_without_0x_prefix

# Optional: Infura API Key (if using Infura RPC)
# NEXT_PUBLIC_INFURA_API_KEY=your_infura_key

# Optional: Alchemy API Key (if using Alchemy RPC)
# NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key
